# ENDOORA Environment Configuration Template
# Copy this file to .env for local development or deploy configuration.
# Never commit credentials or live API keys.

ENDOORA_ENV=development
ENDOORA_TIMEZONE=Asia/Tehran

ENDOORA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENDOORA_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OTP & Messaging Settings
# Provider options: 'mock' (dev/test only), 'kavenegar' (production SMS/phone), 'email'
ENDOORA_OTP_PROVIDER=mock
ENDOORA_OTP_TTL_SECONDS=300
ENDOORA_ACCOUNT_DELETE_DELAY_DAYS=7

# Kavenegar SMS Provider Settings
ENDOORA_SMS_API_KEY=
ENDOORA_KAVENEGAR_API_KEY=
ENDOORA_KAVENEGAR_SENDER=
ENDOORA_KAVENEGAR_TIMEOUT_SECONDS=10

# Transactional Email Settings (SMTP)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ENDOORA_EMAIL_HOST=localhost
ENDOORA_EMAIL_PORT=587
ENDOORA_EMAIL_HOST_USER=
ENDOORA_EMAIL_HOST_PASSWORD=
ENDOORA_EMAIL_USE_TLS=1
ENDOORA_DEFAULT_FROM_EMAIL=no-reply@endoora.ir

# Local browser/server origins
ENDOORA_WEB_ORIGIN=http://localhost:3000
ENDOORA_API_ORIGIN=http://localhost:8000
ENDOORA_API_INTERNAL_URL=http://127.0.0.1:8000

# Django Core
ENDOORA_DJANGO_SECRET_KEY=local-development-only-change-me
ENDOORA_DEBUG=1
ENDOORA_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
ENDOORA_DB_NAME=endoora
ENDOORA_DB_USER=endoora
ENDOORA_DB_PASSWORD=endoora_local_dev
ENDOORA_DB_HOST=127.0.0.1
ENDOORA_DB_PORT=5432

# Redis Cache & Queues
ENDOORA_REDIS_URL=redis://127.0.0.1:6379/0

# AI & Payments
ENDOORA_OPENROUTER_API_KEY=
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=0

ENDOORA_PUBLIC_URL=https://endoora.ir

# Classroom provider (required to join a live room)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
