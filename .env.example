# Copy this file to .env for LOCAL development only.
# Never commit the real .env file.

ENDOORA_ENV=development
ENDOORA_TIMEZONE=Asia/Tehran

# Local browser/server origins
ENDOORA_WEB_ORIGIN=http://localhost:3000
ENDOORA_API_ORIGIN=http://localhost:8000
ENDOORA_API_INTERNAL_URL=http://127.0.0.1:8000

# Django local-only values
ENDOORA_DJANGO_SECRET_KEY=local-development-only-change-me
ENDOORA_DEBUG=1
ENDOORA_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL local development
ENDOORA_DB_NAME=endoora
ENDOORA_DB_USER=endoora
ENDOORA_DB_PASSWORD=endoora_local_dev
ENDOORA_DB_HOST=127.0.0.1
ENDOORA_DB_PORT=5432

# Redis local development
ENDOORA_REDIS_URL=redis://127.0.0.1:6379/0

# Provider placeholders. Leave blank on Day 02.
ENDOORA_OPENROUTER_API_KEY=
ENDOORA_ZARINPAL_MERCHANT_ID=
ENDOORA_SMS_API_KEY=
