{
  "name": "endoora",
  "version": "0.4.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/ui",
    "packages/contracts"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @endoora/web",
    "dev:api": "powershell -Command \"cd apps/api; ./.venv/Scripts/python.exe manage.py runserver 127.0.0.1:8000\"",
    "build": "npm run build --workspace @endoora/web",
    "lint": "npm run lint --workspace @endoora/web",
    "typecheck": "npm run typecheck --workspace @endoora/ui && npm run typecheck --workspace @endoora/contracts && npm run typecheck --workspace @endoora/web",
    "check:design": "node scripts/check-design-tokens.mjs",
    "check:components": "node scripts/check-components.mjs",
    "check:public": "node --experimental-strip-types scripts/check-public-site.mjs",
    "check:public:routes": "node --experimental-strip-types scripts/check-public-routes.mjs",
    "check:ia": "node scripts/check-information-architecture.mjs",
    "check:day07": "node scripts/check-day07.mjs",
    "check:day08": "node scripts/check-day08.mjs",
    "check:day09": "node scripts/check-day09.mjs",
    "check:day10": "node scripts/check-day10.mjs",
    "check:day01-10": "node scripts/check-day01-10.mjs",
    "check:lessons": "node --experimental-strip-types scripts/check-bilingual-and-lessons.mjs",
    "check:highschool": "node --experimental-strip-types scripts/check-highschool-module.mjs",
    "check:tamrin20": "node --experimental-strip-types scripts/check-tamrin-ta-20.mjs",
    "check:skills": "node --experimental-strip-types scripts/check-skills-revamp.mjs",
    "check:skills:games": "node --experimental-strip-types scripts/check-skills-games.mjs",
    "check:listening": "node --experimental-strip-types scripts/check-listening-system.mjs",
    "seed:ielts": "node --experimental-strip-types scripts/seed-ielts.ts",
    "seed:ielts:py": "powershell -Command \"cd apps/api; ./.venv/Scripts/python.exe seed_ielts.py\"",
    "import:ielts": "powershell -Command \"cd apps/api; ./.venv/Scripts/python.exe ../../scripts/bulk_import_ielts.py\"",
    "test:ielts": "node --experimental-strip-types scripts/test-ielts-engine.mjs"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  }
}
